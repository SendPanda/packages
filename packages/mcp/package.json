{
  "name": "@sendpanda/mcp",
  "version": "0.5.5",
  "mcpName": "io.github.SendPanda/sendpanda",
  "description": "Official SendPanda MCP server: transactional email, domains, templates, webhooks and marketing broadcasts.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "private": false,
  "type": "module",
  "sideEffects": false,
  "bin": {
    "sendpanda-mcp": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SendPanda/packages.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://sendpanda.email/docs",
  "keywords": [
    "sendpanda",
    "mcp",
    "email",
    "marketing"
  ],
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.3.6"
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm,cjs --no-splitting --clean && tsc -p tsconfig.build.json && node ../../scripts/prepare-sdk.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/SendPanda/packages/issues"
  }
}
